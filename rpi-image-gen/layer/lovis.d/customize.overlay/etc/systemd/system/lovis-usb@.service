[Unit]
Description=Mount USB %I at /mnt/usb and run start.sh
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=simple
Environment=HOME=/root SDL_VIDEODRIVER=kmsdrm LOVE_GRAPHICS_USE_OPENGLES=1
ExecStart=/usr/local/sbin/lovis-usb start %I
ExecStopPost=/usr/local/sbin/lovis-usb stop %I
KillMode=control-group
TimeoutStopSec=5
