ACTION=="remove", GOTO="abacus_2_end"
SUBSYSTEM!="block", GOTO="abacus_2_end"
ENV{ID_BUS}!="usb", GOTO="abacus_2_end"
ENV{ID_FS_USAGE}!="filesystem", GOTO="abacus_2_end"

ENV{DEVTYPE}=="partition", TAG+="systemd", ENV{SYSTEMD_WANTS}+="abacus-2-usb@%k.service"
ENV{DEVTYPE}=="disk", ENV{ID_PART_TABLE_TYPE}=="", TAG+="systemd", ENV{SYSTEMD_WANTS}+="abacus-2-usb@%k.service"

LABEL="abacus_2_end"
